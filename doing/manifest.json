 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "dir": "rtl",
 "lang": "he",
 "background_color": "#F3F5F9",
 "theme_color": "#1E5A96",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512-maskable.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "text/vcard",
      "text/x-vcard",
      "text/directory",
      "text/*",
      ".vcf",
      ".vcard"
     ]
    }
   ]
  }
 }
}